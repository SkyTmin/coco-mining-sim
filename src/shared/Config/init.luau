--!strict
-- The JSON modules are generated by scripts/build-configs.mjs.

export type GameConfig = {
	defaultLanguage: string,
	languages: { string },
	autosaveSeconds: number,
}

export type CreativeConfig = {
	admins: { number },
}

export type MineConfig = {
	blockSize: number,
	startWidth: number,
	height: number,
	maxWidth: number,
	maxHeight: number,
	maxDepth: number,
	chunk: number,
	window: number,
	maxHoles: number,
	maxHitsPerBlock: number,
	passThrough: { number },
	plate: { hits: number, cap: number, ultMultiplier: number },
	ultCharge: number,
}

export type PickaxeConfig = {
	family: string?,
	rarity: string,
	storm: { jumps: { number }, pickRareWithin: number }?,
}
export type RarityConfig = { stars: number, power: number, cap: number, ult: number, lvlC0: number }
export type CardConfig = {
	c0: number,
	per: number,
	mult: boolean?,
	world: number,
	cap: number?,
	steps: { number },
}
export type ProgressConfig = {
	widths: { { w: number, price: number, world: number? } },
	hitSizes: { { id: number, shape: string, blocks: number, interval: number, price: number } },
	rarities: { [string]: RarityConfig },
	pickLevel: { powerPerLevel: number, ultPerLevel: number, costGrowth: number },
	gold: { power: number, capBonus: number },
	cards: { [string]: CardConfig },
	cardGrowth: number,
	cardEffects: {
		heavyEvery: number,
		heavyMultiplier: number,
		powerPierce: number,
		rainChance: number,
		rainMultiplier: number,
		critMultiplier: number,
		megaEvery: number,
		megaMultiplier: number,
		critPierce: number,
	},
}
export type PlotConfig = {
	count: number,
	entranceRadius: number,
	frameWidth: number,
	platformDepth: number,
	spectatorDepth: number,
}
export type CascadeConfig = { maxGen: number, maxCells: number, maxRuns: number }

export type FxConfig = {
	depth: {
		fogStart: number,
		fogEnd: number,
		simpleFrom: number,
		lampSpacing: number,
		distantSpacing: number,
	},
	impactTime: number,
	ult: {
		windup: number,
		fractureMin: number,
		fractureMax: number,
		fracturePerLog: number,
		empty: number,
		approachBase: number,
		approachPerLog: number,
		distanceBase: number,
		distancePerLog: number,
		distanceDeep: number,
	},
}

export type SoundsConfig = {
	atlasId: string?,
	clips: { [string]: { { number } } },
	rules: {
		maxVolume: number,
		frequentVolume: number,
		linkVolume: number,
		defaultSfx: number,
		frequentLufs: number,
		rareLufs: number,
		lowpassHz: number,
		fadeSeconds: number,
		pitchSpread: number,
		fatigueDelay: number,
		fatigueGain: number,
		voices: { [string]: number },
	},
}

export type OreConfig = { id: string, color: { number }, texture: string? }
export type WorldLook = {
	material: string,
	wall: { number },
	fog: { number },
	lamp: { number },
	glow: { number },
	decor: { number },
}
export type WorldConfig = {
	look: WorldLook?,
	id: string,
	length: number,
	ores: { { string | number } },
	prices: { [string]: number },
	hardStart: number,
	hardEnd: number,
	rockValue: number,
	plate: { recommendedStrength: number, hp: number, reward: number },
	specials: { perChunk: number, kinds: { { string | number } } },
	color: { number },
}

local mine = require(script:WaitForChild("mine")) :: MineConfig
local progress = require(script:WaitForChild("progress")) :: ProgressConfig
return {
	game = require(script:WaitForChild("game")) :: GameConfig,
	creative = require(script:WaitForChild("creative")) :: CreativeConfig,
	mine = mine,
	plots = require(script:WaitForChild("plots")) :: PlotConfig,
	pickaxes = require(script:WaitForChild("pickaxes")) :: { [string]: PickaxeConfig },
	progress = progress,
	fx = require(script:WaitForChild("fx")) :: FxConfig,
	sounds = require(script:WaitForChild("sounds")) :: SoundsConfig,
	cascade = require(script:WaitForChild("cascade")) :: CascadeConfig,
	ores = require(script:WaitForChild("ores")) :: { OreConfig },
	worlds = require(script:WaitForChild("worlds")) :: { WorldConfig },
}
