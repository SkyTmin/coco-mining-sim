--!strict
-- Cel-shaded models [владелец 11.11: стиль 6 — толстая чёрная обводка, плоские цвета] built at runtime with
-- EditableMesh: one coloured MeshPart per model plus one black inverted-hull MeshPart for the outline (only its inner
-- faces render, so the ink shows around the silhouette from every angle). Data comes from CelPickData / CelChestData
-- (generated by assets/pickaxes/export-roblox.mjs). Model space: x across, y up, z towards the viewer; mapped to Roblox
-- as (x, y, z) → (−z, y, x), the same frame the old voxel pickaxe used (thickness along X, height along Y).
-- Built once per (id, size); callers clone the template. Returns nil when EditableMesh is unavailable.
local AssetService = game:GetService("AssetService")
local CelMesh = {}

local INK = Color3.fromHex("15121E")
local SEGMENTS = 14

type Builder = {
	em: EditableMesh,
	colors: { [string]: number },
	normals: { [string]: number },
	vertices: { [string]: number },
	low: Vector3,
	high: Vector3,
	transform: (Vector3) -> Vector3,
	rotate: (Vector3) -> Vector3,
}

local function colorId(b: Builder, color: Color3): number
	local key = color:ToHex()
	local id = b.colors[key]
	if not id then
		id = b.em:AddColor(color, 1)
		b.colors[key] = id
	end
	return id
end

-- add a triangle in model space; `outward` is the face direction in model space, `inside` flips it (outline hull)
local function tri(
	b: Builder,
	p1: Vector3,
	p2: Vector3,
	p3: Vector3,
	color: Color3,
	inside: boolean
)
	local a, c2, c3 = b.transform(p1), b.transform(p2), b.transform(p3)
	local n = (c2 - a):Cross(c3 - a)
	if n.Magnitude < 1e-9 then
		return
	end
	n = n.Unit
	if inside then
		c2, c3, n = c3, c2, -n
	end
	local em = b.em
	-- colours and normals are per face corner, so positions are shared: far fewer vertices, far less mesh memory
	local function vertex(v: Vector3): number
		local key = string.format("%.3f %.3f %.3f", v.X, v.Y, v.Z)
		local id = b.vertices[key]
		if not id then
			id = em:AddVertex(v)
			b.vertices[key] = id
		end
		return id
	end
	local v1, v2, v3 = vertex(a), vertex(c2), vertex(c3)
	if v1 == v2 or v2 == v3 or v1 == v3 then
		return
	end
	local face = em:AddTriangle(v1, v2, v3)
	local cid = colorId(b, color)
	em:SetFaceColors(face, { cid, cid, cid })
	local nkey = string.format("%.2f %.2f %.2f", n.X, n.Y, n.Z)
	local nid = b.normals[nkey]
	if not nid then
		nid = em:AddNormal(n)
		b.normals[nkey] = nid
	end
	em:SetFaceNormals(face, { nid, nid, nid })
	for _, v in { a, c2, c3 } do
		b.low, b.high = b.low:Min(v), b.high:Max(v)
	end
end

-- triangle given in model space with a known outward direction: fix the winding so its normal points outward
local function face(
	b: Builder,
	p1: Vector3,
	p2: Vector3,
	p3: Vector3,
	out: Vector3,
	color: Color3,
	inside: boolean
)
	if (p2 - p1):Cross(p3 - p1):Dot(out) < 0 then
		p2, p3 = p3, p2
	end
	tri(b, p1, p2, p3, color, inside)
end

local function quad(
	b: Builder,
	a: Vector3,
	c2: Vector3,
	c3: Vector3,
	d: Vector3,
	out: Vector3,
	color: Color3,
	inside: boolean
)
	face(b, a, c2, c3, out, color, inside)
	face(b, a, c3, d, out, color, inside)
end

local function signedArea(pts: { Vector2 }): number
	local s = 0
	for i, p in pts do
		local q = pts[i % #pts + 1]
		s += p.X * q.Y - q.X * p.Y
	end
	return s / 2
end

-- the preview's outline offset: move each vertex along its corner bisector, mitre capped at 2.5
local function offset(pts: { Vector2 }, d: number): { Vector2 }
	local out = {}
	local n = #pts
	for i = 1, n do
		local a, p, c = pts[(i - 2) % n + 1], pts[i], pts[i % n + 1]
		local e1, e2 = p - a, c - p
		local n1 = if e1.Magnitude > 0 then Vector2.new(e1.Y, -e1.X).Unit else Vector2.zero
		local n2 = if e2.Magnitude > 0 then Vector2.new(e2.Y, -e2.X).Unit else Vector2.zero
		local m = n1 + n2
		m = if m.Magnitude > 0 then m.Unit else n1
		local k = math.min(2.5, 1 / math.max(0.2, m:Dot(n1)))
		out[i] = p + m * d * k
	end
	return out
end

local function prism(
	b: Builder,
	pts: { Vector2 },
	tris: { number },
	z0: number,
	z1: number,
	faceColor: Color3,
	sideColor: Color3,
	inside: boolean
)
	local front, back = Vector3.new(0, 0, 1), Vector3.new(0, 0, -1)
	for i = 1, #tris, 3 do
		local p1, p2, p3 = pts[tris[i]], pts[tris[i + 1]], pts[tris[i + 2]]
		face(
			b,
			Vector3.new(p1.X, p1.Y, z1),
			Vector3.new(p2.X, p2.Y, z1),
			Vector3.new(p3.X, p3.Y, z1),
			front,
			faceColor,
			inside
		)
		face(
			b,
			Vector3.new(p1.X, p1.Y, z0),
			Vector3.new(p2.X, p2.Y, z0),
			Vector3.new(p3.X, p3.Y, z0),
			back,
			faceColor,
			inside
		)
	end
	-- the points are counter-clockwise, so the outward side normal of edge p → q is (dy, −dx)
	for i, p in pts do
		local q = pts[i % #pts + 1]
		local e = q - p
		if e.Magnitude > 1e-6 then
			local out = Vector3.new(e.Y, -e.X, 0)
			quad(
				b,
				Vector3.new(p.X, p.Y, z0),
				Vector3.new(q.X, q.Y, z0),
				Vector3.new(q.X, q.Y, z1),
				Vector3.new(p.X, p.Y, z1),
				out,
				sideColor,
				inside
			)
		end
	end
end

local function cylinder(
	b: Builder,
	a: Vector3,
	c: Vector3,
	r: number,
	color: Color3,
	inside: boolean
)
	local axis = (c - a)
	if axis.Magnitude < 1e-6 then
		return
	end
	local dir = axis.Unit
	local u = (if math.abs(dir.Y) < 0.9 then Vector3.yAxis else Vector3.xAxis):Cross(dir).Unit
	local v = dir:Cross(u)
	local ring = {}
	for i = 1, SEGMENTS do
		local t = (i - 1) / SEGMENTS * math.pi * 2
		ring[i] = u * math.cos(t) * r + v * math.sin(t) * r
	end
	for i = 1, SEGMENTS do
		local p, q = ring[i], ring[i % SEGMENTS + 1]
		quad(b, a + p, a + q, c + q, c + p, (p + q) / 2, color, inside)
		face(b, a, a + p, a + q, -dir, color, inside)
		face(b, c, c + p, c + q, dir, color, inside)
	end
end

local function sphere(b: Builder, at: Vector3, r: number, color: Color3, inside: boolean)
	local rows, cols = 7, 12
	local function point(i: number, j: number): Vector3
		local th, ph = i / rows * math.pi, j / cols * math.pi * 2
		return at
			+ Vector3.new(
					math.sin(th) * math.cos(ph),
					math.cos(th),
					math.sin(th) * math.sin(ph)
				)
				* r
	end
	for i = 0, rows - 1 do
		for j = 0, cols - 1 do
			local p1, p2, p3, p4 =
				point(i, j), point(i + 1, j), point(i + 1, j + 1), point(i, j + 1)
			local out = (p1 + p2 + p3 + p4) / 4 - at
			if i > 0 then
				face(b, p1, p2, p4, out, color, inside)
			end
			if i < rows - 1 then
				face(b, p2, p3, p4, out, color, inside)
			end
		end
	end
end

local function box(
	b: Builder,
	at: Vector3,
	size: Vector3,
	ry: number,
	rz: number,
	front: Color3,
	top: Color3,
	side: Color3,
	inside: boolean
)
	local frame = CFrame.new(at) * CFrame.Angles(0, ry, 0) * CFrame.Angles(0, 0, rz)
	local h = size / 2
	local function corner(x: number, y: number, z: number): Vector3
		return frame:PointToWorldSpace(Vector3.new(x * h.X, y * h.Y, z * h.Z))
	end
	local sides = {
		{ Vector3.xAxis, side },
		{ -Vector3.xAxis, side },
		{ Vector3.yAxis, top },
		{ -Vector3.yAxis, side },
		{ Vector3.zAxis, front },
		{ -Vector3.zAxis, front },
	}
	for _, s in sides do
		local n: Vector3 = s[1]
		local a1 = if math.abs(n.X) > 0 then Vector3.yAxis else Vector3.xAxis
		local a2 = n:Cross(a1)
		local function c(sa: number, sb: number): Vector3
			local v = n + a1 * sa + a2 * sb
			return corner(v.X, v.Y, v.Z)
		end
		quad(b, c(-1, -1), c(1, -1), c(1, 1), c(-1, 1), frame:VectorToWorldSpace(n), s[2], inside)
	end
end

-- half cylinder lid along X, flat side down
local function halfCylinder(
	b: Builder,
	at: Vector3,
	r: number,
	len: number,
	color: Color3,
	inside: boolean
)
	local x0, x1 = at.X - len / 2, at.X + len / 2
	local steps = SEGMENTS // 2
	for i = 1, steps do
		local t0, t1 = (i - 1) / steps * math.pi, i / steps * math.pi
		local p = Vector3.new(0, math.sin(t0) * r, math.cos(t0) * r)
		local q = Vector3.new(0, math.sin(t1) * r, math.cos(t1) * r)
		local base = Vector3.new(0, at.Y, at.Z)
		quad(
			b,
			Vector3.new(x0, 0, 0) + base + p,
			Vector3.new(x1, 0, 0) + base + p,
			Vector3.new(x1, 0, 0) + base + q,
			Vector3.new(x0, 0, 0) + base + q,
			(p + q) / 2,
			color,
			inside
		)
		for _, x in { x0, x1 } do
			local c = Vector3.new(x, at.Y, at.Z)
			face(b, c, c + p, c + q, Vector3.new(x - at.X, 0, 0), color, inside)
		end
	end
	local base = Vector3.new(0, at.Y, at.Z)
	quad(
		b,
		Vector3.new(x0, 0, -r) + base,
		Vector3.new(x1, 0, -r) + base,
		Vector3.new(x1, 0, r) + base,
		Vector3.new(x0, 0, r) + base,
		-Vector3.yAxis,
		color,
		inside
	)
end

local function newBuilder(transform: (Vector3) -> Vector3): Builder
	-- nil when the device's EditableMesh memory budget is used up: the caller keeps the stand-in model
	local em = AssetService:CreateEditableMesh()
	assert(em, "EditableMesh budget exhausted")
	return {
		em = em,
		colors = {},
		normals = {},
		vertices = {},
		low = Vector3.one * math.huge,
		high = -Vector3.one * math.huge,
		transform = transform,
		rotate = transform,
	}
end

local function fill(b: Builder, prims: { { any } }, outline: boolean)
	for _, p in prims do
		local kind = p[1]
		if kind == "p" then
			local z, d, ol = p[2], p[3], p[6]
			local flat, pts = p[7], {}
			for i = 1, #flat, 2 do
				table.insert(pts, Vector2.new(flat[i], flat[i + 1]))
			end
			if signedArea(pts) < 0 then
				continue -- the exporter always writes counter-clockwise points
			end
			if outline then
				if ol > 0 then
					local half = d / 2 + ol * 0.5
					prism(b, offset(pts, ol), p[8], z - half, z + half, INK, INK, true)
				end
			else
				prism(
					b,
					pts,
					p[8],
					z - d / 2,
					z + d / 2,
					Color3.fromHex(p[4]),
					Color3.fromHex(p[5]),
					false
				)
			end
		elseif kind == "c" then
			local a, c, r, ol =
				Vector3.new(p[2], p[3], p[4]), Vector3.new(p[5], p[6], p[7]), p[8], p[10]
			if outline then
				if ol > 0 then
					local dir = (c - a).Unit
					cylinder(b, a - dir * ol, c + dir * ol, r + ol, INK, true)
				end
			else
				cylinder(b, a, c, r, Color3.fromHex(p[9]), false)
			end
		elseif kind == "b" then
			local at, r, ol = Vector3.new(p[2], p[3], p[4]), p[5], p[7]
			if outline then
				if ol > 0 then
					sphere(b, at, r + ol, INK, true)
				end
			else
				sphere(b, at, r, Color3.fromHex(p[6]), false)
			end
		elseif kind == "x" then
			local at, size, ol = Vector3.new(p[2], p[3], p[4]), Vector3.new(p[5], p[6], p[7]), p[13]
			if outline then
				if ol > 0 then
					box(b, at, size + Vector3.one * ol * 2, p[8], p[9], INK, INK, INK, true)
				end
			else
				box(
					b,
					at,
					size,
					p[8],
					p[9],
					Color3.fromHex(p[10]),
					Color3.fromHex(p[11]),
					Color3.fromHex(p[12]),
					false
				)
			end
		elseif kind == "h" then
			local at, r, len, ol = Vector3.new(p[2], p[3], p[4]), p[5], p[6], p[8]
			if outline then
				if ol > 0 then
					halfCylinder(b, at, r + ol, len + ol * 2, INK, true)
				end
			else
				halfCylinder(b, at, r, len, Color3.fromHex(p[7]), false)
			end
		end
	end
end

local function meshPart(b: Builder, name: string): MeshPart?
	if b.high.X < b.low.X then
		return nil
	end
	-- a growable EditableMesh reserves a big share of the device budget (only ~6 fit); a fixed-size copy is cheap
	-- (76 fitted in a test), so build growable, copy fixed, free the growable one
	local ok, part = pcall(function()
		local fixed =
			AssetService:CreateEditableMeshAsync(Content.fromObject(b.em), { FixedSize = true })
		b.em:Destroy()
		return AssetService:CreateMeshPartAsync(Content.fromObject(fixed))
	end)
	if not ok or not part then
		warn("[CelMesh] " .. tostring(part))
		return nil
	end
	local mp = part :: MeshPart
	mp.Name, mp.Material, mp.CastShadow = name, Enum.Material.SmoothPlastic, false
	mp.Anchored, mp.CanCollide, mp.CanTouch, mp.CanQuery, mp.Massless =
		true, false, false, false, true
	mp.Size = b.high - b.low
	mp.CFrame = CFrame.new((b.low + b.high) / 2)
	return mp
end

-- bounds of the model in Roblox axes (after the axis swap and `turn`), from the primitives' sample points
local function bounds(
	prims: { { any } },
	turn: CFrame,
	swap: (Vector3) -> Vector3,
	solid: boolean
): (Vector3, Vector3)
	local low, high = Vector3.one * math.huge, -Vector3.one * math.huge
	local function add(v: Vector3)
		local w = turn:VectorToWorldSpace(swap(v))
		low, high = low:Min(w), high:Max(w)
	end
	for _, p in prims do
		if p[1] == "p" and not solid then
			local flat = p[7]
			for i = 1, #flat, 2 do
				add(Vector3.new(flat[i], flat[i + 1], p[2] - p[3] / 2))
				add(Vector3.new(flat[i], flat[i + 1], p[2] + p[3] / 2))
			end
		elseif p[1] == "c" then
			add(Vector3.new(p[2], p[3], p[4]))
			add(Vector3.new(p[5], p[6], p[7]))
		elseif p[1] == "b" then
			local r = p[5]
			add(Vector3.new(p[2], p[3], p[4]) - Vector3.one * r)
			add(Vector3.new(p[2], p[3], p[4]) + Vector3.one * r)
		elseif p[1] == "x" then
			local half = Vector3.new(p[5], p[6], p[7]) / 2
			add(Vector3.new(p[2], p[3], p[4]) - half)
			add(Vector3.new(p[2], p[3], p[4]) + half)
		elseif p[1] == "h" then
			local half = Vector3.new(p[6] / 2, p[5], p[5])
			add(Vector3.new(p[2], p[3], p[4]) - Vector3.new(half.X, 0, half.Z))
			add(Vector3.new(p[2], p[3], p[4]) + half)
		end
	end
	return low, high
end

export type Options = {
	size: number, -- the larger of the turned model's height and width, in studs
	tilt: number?, -- degrees about Roblox X (the old voxel pickaxe used 45)
	sizeAxes: string?, -- "yz" (default: height/width as the pickaxe) or "all"
	solidBounds: boolean?, -- size by the solid parts only (chests: the sparkles around do not shrink the chest)
	axes: string?, -- "swap" (default: (x, y, z) → (−z, y, x), the pickaxe frame) or "xyz" (kept, front = +Z)
}

local cache: { [string]: Model | false } = {}

-- Template model for `prims`: parts are anchored, centred on the model's bounding-box centre (pivot = origin).
function CelMesh.template(key: string, prims: { { any } }, options: Options): Model?
	local cacheKey = key
		.. "|"
		.. options.size
		.. "|"
		.. (options.tilt or 0)
		.. "|"
		.. (options.axes or "swap")
	local hit = cache[cacheKey]
	if hit ~= nil then
		return if hit then hit else nil
	end
	local ok, model = pcall(function()
		local turn = CFrame.Angles(math.rad(options.tilt or 0), 0, 0)
		local swap = if options.axes == "xyz"
			then function(v: Vector3): Vector3
				return v
			end
			else function(v: Vector3): Vector3
				return Vector3.new(-v.Z, v.Y, v.X)
			end
		local low, high = bounds(prims, turn, swap, options.solidBounds == true)
		local extent = high - low
		local span = if options.sizeAxes == "all"
			then math.max(extent.X, extent.Y, extent.Z)
			else math.max(extent.Y, extent.Z)
		local scale = options.size / math.max(span, 1e-3)
		local centre = (low + high) / 2
		local function transform(v: Vector3): Vector3
			return (turn:VectorToWorldSpace(swap(v)) - centre) * scale
		end
		local m = Instance.new("Model")
		m.Name = "Cel_" .. key
		local body = newBuilder(transform)
		fill(body, prims, false)
		local ink = newBuilder(transform)
		fill(ink, prims, true)
		local bodyPart = meshPart(body, "CelBody")
		if not bodyPart then
			return nil
		end
		bodyPart.Parent = m
		m.PrimaryPart = bodyPart
		local inkPart = meshPart(ink, "CelInk")
		if inkPart then
			inkPart.Parent = m
		end
		-- glows: a soft round billboard and a light, sized in model units
		for _, p in prims do
			if p[1] == "g" then
				local at = transform(Vector3.new(p[2], p[3], p[4]))
				local r = p[5] * scale
				local color = Color3.fromHex(p[6])
				local holder = Instance.new("Part")
				holder.Name, holder.Transparency, holder.Size = "CelGlow", 1, Vector3.one * 0.05
				holder.Anchored, holder.CanCollide, holder.CanTouch, holder.CanQuery, holder.Massless =
					true, false, false, false, true
				holder.CFrame = CFrame.new(at)
				local bb = Instance.new("BillboardGui")
				bb.Size, bb.LightInfluence, bb.Adornee = UDim2.fromScale(r * 2, r * 2), 0, holder
				for i, k in { 1, 0.66, 0.36 } do
					local disc = Instance.new("Frame")
					disc.AnchorPoint, disc.Position =
						Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5)
					disc.Size, disc.BorderSizePixel = UDim2.fromScale(k, k), 0
					disc.BackgroundColor3 = color
					disc.BackgroundTransparency = ({ 0.86, 0.78, 0.66 })[i]
					local corner = Instance.new("UICorner")
					corner.CornerRadius, corner.Parent = UDim.new(0.5, 0), disc
					disc.Parent = bb
				end
				bb.Parent = holder
				local light = Instance.new("PointLight")
				light.Color, light.Range, light.Brightness, light.Shadows =
					color, math.max(2, r * 3), 1.2, false
				light.Parent = holder
				holder.Parent = m
			end
		end
		return m
	end)
	if not ok then
		warn("[CelMesh] " .. tostring(model))
	end
	local result = if ok and model then model :: Model else nil
	cache[cacheKey] = result or false
	return result
end

-- Clone the template and weld it to `root` with `relative` (root space). Parts become unanchored, massless, welded.
function CelMesh.attach(template: Model, root: BasePart, relative: CFrame): Model
	local model = template:Clone()
	model.Name = "CelModel"
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			local offsetFrame = relative * part.CFrame
			part.CFrame, part.Anchored = root.CFrame * offsetFrame, false
			local weld = Instance.new("Weld")
			weld.Part0, weld.Part1, weld.C0, weld.Parent = root, part, offsetFrame, part
		end
	end
	model.Parent = root.Parent
	return model
end

return CelMesh
