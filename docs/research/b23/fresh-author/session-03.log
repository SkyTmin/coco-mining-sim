export function fillSeg(
  p: Pen,
  x0: number,
  y0: number,
  x1: number,
  y1: number,
  hw: number,
  dither = false,
): void {
  const L = Math.hypot(x1 - x0, y1 - y0);
  if (L < 0.01) {
    disc(p, x0, y0, hw, dither);
    return;
  }
  fillLane(p, x0, y0, (x1 - x0) / L, (y1 - y0) / L, 0, L, hw, dither);
}

