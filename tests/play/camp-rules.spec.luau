--!strict
local Test = require("../lib/expect")
local Loader = require("../lib/loader")
local Rules = Loader.load("src/shared/Play/CampRules.luau")
Test.describe("Camp roles", function()
	Test.it("admits four spectators independently of the two helper slots", function()
		local roles = { "viewer", "viewer", "viewer", "guest" }
		assert(Rules.space(roles, "viewer") and Rules.space(roles, "guest"))
		table.insert(roles, "viewer")
		assert(not Rules.space(roles, "viewer") and Rules.space(roles, "guest"))
		table.insert(roles, "guest")
		assert(not Rules.space(roles, "guest"))
	end)
end)
Test.it("gives every world one band and spreads equal depths around the pillar", function()
	local Worlds = Loader.load("src/shared/Mine/Worlds.luau")
	local y, a = Rules.token(Worlds.at(2).start, 1)
	local yy, b = Rules.token(Worlds.at(2).start, 2)
	assert(y == 2.5 and yy == y and a ~= b)
	assert(Rules.token(Worlds.at(10).start, 1) == 22.5)
end)
Test.it("limits likes by target and UTC day", function()
	local p = { likesGiven = { day = 1, ids = {} } }
	assert(not Rules.like(p, 5, 5, 1) and Rules.like(p, 5, 6, 1) and not Rules.like(p, 5, 6, 1))
	assert(Rules.like(p, 5, 7, 1) and Rules.like(p, 5, 6, 2) and not p.likesGiven.ids["7"])
end)
return true
