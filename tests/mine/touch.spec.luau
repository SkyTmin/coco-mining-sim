--!strict
local Test = require("../lib/expect")
local Touch = require("./fixture").load("TouchGesture")
Test.describe("Mobile gesture", function()
	Test.it("waits 0.12 seconds and keeps digging while aiming after a hold", function()
		local g = Touch.begin(500, 180, 0)
		assert(not Touch.step(g, 0.119))
		assert(Touch.step(g, 0.12))
		Touch.move(g, 540, 200)
		assert(Touch.step(g, 0.3))
		assert(not Touch.finish(g, 0.31))
	end)
	Test.it("turns without hits when the thumb drags before the hold", function()
		local g = Touch.begin(500, 180, 0)
		Touch.move(g, 515, 180)
		assert(not Touch.step(g, 0.13))
		assert(not Touch.finish(g, 0.2))
	end)
	Test.it("accepts a short stationary tap exactly once", function()
		local g = Touch.begin(500, 180, 0)
		Touch.move(g, 506, 182)
		assert(Touch.finish(g, 0.08))
		assert(not Touch.finish(g, 0.31))
	end)
end)
