  "moves": [
    {
      "id": "tech_star_spiral",
      "title": "Спираль рождения",
      "template": "summon",
      "weapon": "funnel",
      "reference": "hourlord-hour",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Туманность раскрывается перед тёмной чашей неба.",
        "Больше секунды раздвигает руки, тело раздувается над опорами и сифон наводится на центр вихря.",
        "Гибкий раструб втягивает ближайшую звезду по спирали, за ней закручиваются дальние.",
        "Вспышка разрывает спираль и выбрасывает звёзды в разные стороны.",
        "Мантия опадает, руки расходятся по собственным течениям."
      ]
    },
    {
      "id": "tech_lunar_hook",
      "title": "Лунный крюк",
      "template": "sweep",
      "weapon": "star2",
      "reference": "mammoth-tusks",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Левая короткая рука поддевает край луны.",
        "Поворачивает тело над противоположными опорами и сворачивает руку крюком.",
        "Концевая звезда срезает дугу перед глазами.",
        "По реальному пути конца проходит трехцветная коса световой пыли.",
        "Рука разматывается, течение возвращает тело."
      ]
    },
    {
      "id": "tech_tidal_club",
      "title": "Дно созвездия",
      "template": "overhead",
      "weapon": "clubL",
      "reference": "guardian-strike",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Левая булава нащупывает площадку под туманностью.",
        "Длинный стебель выгибается высоко, остальные руки группируются у основания.",
        "Булавовидный конец ложится на открытое дно.",
        "От контакта расходятся круги набегающей космической пыли.",
        "Стебель оттягивает булаву по спирали назад."
      ]
    },
    {
      "id": "tech_long_cast",
      "title": "Ловчая комета",
      "template": "ram",
      "weapon": "clubR",
      "reference": "mammoth-tusks",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Правая длинная ловчая преследует звезду.",
        "Задержав набранную петлю, кальмар переносит вес на противоположную сторону.",
        "Удлинённая булава замыкает бросок на далёкой световой цели.",
        "Звезда вспыхивает между чашечками, остаётся игольчатый след.",
        "Стебель отдёргивается после короткой выдержки."
      ]
    },
    {
      "id": "tech_orbit_chimes",
      "title": "Звёздные колокола",
      "template": "pillars",
      "weapon": "star6",
      "reference": "mammoth-stomp",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Правая короткая рука находит нижнее звено орбитальной карты.",
        "Шесть соседних рук поддерживают мантию, конец поднимается над узлом.",
        "Концевая звезда прикасается к узлу на дне.",
        "На разных планах отвечают три высоких световых колокола.",
        "Рука снова скользит по линии орбиты."
      ]
    },
    {
      "id": "tech_comet_form",
      "title": "Сердце кометы",
      "template": "dive",
      "weapon": "mantleTip",
      "reference": "guardian-strike",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Острие мантии принимает звёздный курс.",
        "Плавники прижимаются, руки струятся одной связкой, мантия вытягивается в копьё.",
        "Настоящая задняя вершина пересекает цель в полёте.",
        "По траектории кометы загораются ступени света и хвост ледяной пыли.",
        "Плавники тормозят движение, мантия возвращает прежнюю форму."
      ]
    }
  ],
