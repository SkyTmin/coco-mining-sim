  "moves": [
    {
      "id": "tech_sand_vortex",
      "title": "Погребённый полдень",
      "template": "summon",
      "weapon": "sting",
      "reference": "hourlord-hour",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Анкхар метит песчаную площадку кристаллом.",
        "Дольше секунды выгибает хвост назад, задние опоры принимают вес.",
        "Весь ряд звеньев раскручивается вперёд, остриё входит в открытый песок.",
        "Из точки прокола вырастает вихрь с солнечной кромкой и тёмными витками.",
        "Вихрь оседает слоями, хвост складывается снизу вверх."
      ]
    },
    {
      "id": "tech_gate_claw",
      "title": "Затвор усыпальницы",
      "template": "overhead",
      "weapon": "clawR",
      "reference": "guardian-strike",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Правая клешня ловит каменный затвор.",
        "Скорпион выпрямляется на левом ряду ног и поднимает правую ладонь.",
        "Цевка бросает тяжёлую клешню вниз, неподвижный палец ударяет плиту.",
        "Кромка плиты раскалывается на трапециевидные песчаные ступени.",
        "Клешня отпружинивает, освобождённые ноги возвращаются на песок."
      ]
    },
    {
      "id": "tech_crescent_cut",
      "title": "Левый серп",
      "template": "sweep",
      "weapon": "clawL",
      "reference": "mammoth-tusks",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Левая клешня открывается перед шёлковой завесой.",
        "Боковой перенос веса проводит плечо за переднюю ногу.",
        "Левая клешня проносится поперёк и пальцы сходятся перед створом.",
        "В воздухе расходятся два тонких серпа с золотой кромкой.",
        "Разворот заканчивается, пальцы расходятся."
      ]
    },
    {
      "id": "tech_beacon",
      "title": "Три огня дозора",
      "template": "volley",
      "weapon": "stingFacet",
      "reference": "puppeteer-cut",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Вершина хвоста ищет дальние сигнальные чаши.",
        "Мантия опускается, звенья хвоста собирают пружину.",
        "Кристалл трижды нацеливается и сбрасывает светящиеся зёрна.",
        "Три ступенчатых вспышки отвечают из глубины гробницы.",
        "Последняя искра стекает вниз по сегментам."
      ]
    },
    {
      "id": "tech_dune_drum",
      "title": "Шаг погребального хора",
      "template": "pillars",
      "weapon": "footR0",
      "reference": "mammoth-stomp",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Передняя ходильная лапа вызывает ответ песчаных гряд.",
        "Семь опор удерживают массу, правая передняя нога поднимает коготь.",
        "Остриё ноги бьёт в плиту, таз и хвост проседают.",
        "Барханы отвечают по очереди, вдали нарастают три столба песка.",
        "След схлопывается, поднятая лапа возвращается рядом с соседней."
      ]
    }
  ],
