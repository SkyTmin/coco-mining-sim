  "moves": [
    {
      "id": "tech_cleave",
      "title": "Рубка тесаком",
      "template": "overhead",
      "weapon": "weaponTip",
      "reference": "mammoth-stomp",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Архив cleaveAim. Король правой лапой рубит камень тесаком.",
        "Вес отходит на заднюю пятку, лезвие за правым плечом.",
        "Крюк касается открытого пола впереди правого носка.",
        "Расщеплённая отметина и медная искра привязаны к кромке.",
        "Локоть принимает отскок, рукоять возвращается к бедру."
      ]
    },
    {
      "id": "tech_whip",
      "title": "Хлыст хвостом",
      "template": "sweep",
      "weapon": "tailTip",
      "reference": "puppeteer-cut",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Архив whipAim. Груз плетёного хвоста хлещет поперёк камней.",
        "Бёдра закручиваются, хвост собирается сзади.",
        "Груз распрямляется и касается камня сбоку.",
        "Скол и короткая черта идут за грузом.",
        "Хвост затухает последним, вес снова над стопами."
      ]
    },
    {
      "id": "tech_roll",
      "title": "Коронный перекат",
      "template": "ram",
      "weapon": "shoulderR",
      "reference": "mammoth-tusks",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Архив rollAim → roll. Король таранит грудку шлака плечом.",
        "Голову прячет в ворот, тесак прижимает к боку.",
        "Плечо врезается в комок перед телом.",
        "Комок распадается над низкой полосой пыли.",
        "Стопы ловят вес после оборота, хвост догоняет."
      ]
    },
    {
      "id": "tech_summon",
      "title": "Призыв стражи",
      "template": "summon",
      "weapon": "handL",
      "reference": "guardian-strike",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Архив summon. Левая лапа подаёт сигнал Малому королю.",
        "Король склоняется и набирает воздух.",
        "Раскрытая ладонь выбрасывает три латунные искры к решётке.",
        "Малый король появляется у ступни и высовывает морду рядом со старшим.",
        "Кисть опускается, страж уходит за край плаща."
      ]
    },
    {
      "id": "tech_sweep",
      "title": "Тройной взмах рельсом",
      "template": "sweep",
      "weapon": "weaponTip",
      "reference": "puppeteer-cut",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 3
      },
      "logic": [
        "Архив swap → sweepAim. Правой лапой берёт короткий рельс.",
        "Левое плечо отводит назад, правая нога шагает наружу.",
        "Три удара краем рельса высекают сколы на полу.",
        "Каждая борозда начинается у носка рельса, полы следуют за тазом.",
        "Плечи гасят третий взмах, рельс возвращается за спину."
      ]
    },
    {
      "id": "tech_leap",
      "title": "Прыжок с ударной волной",
      "template": "leap",
      "weapon": "footL",
      "reference": "mammoth-stomp",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Архив leapAim → leap. Король тяжело опускается на каменные плиты.",
        "Сжимает колени и прижимает тесак, затем обе стопы отрываются.",
        "Передняя левая лапа принимает вес у края плиты.",
        "Кольцо расходится от передней лапы, вторая лапа догружает плиту.",
        "Колени пружинят, хвост и плащ опускаются позже."
      ]
    }
  ],
