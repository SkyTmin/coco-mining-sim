  "moves": [
    {
      "id": "tech_chart_route",
      "title": "Курс на сокровище",
      "template": "summon",
      "weapon": "sabre",
      "reference": "hourlord-hour",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Чернилус разворачивает карту перед мундиром.",
        "Больше секунды изучает берег и отводит саблю назад.",
        "Разворотом всей мантии опускает остриё к открытому дну.",
        "От острия бегут линии чернильного маршрута; в конце вспыхивает крест.",
        "Полотно карты сворачивается, сабля возвращается в караул."
      ]
    },
    {
      "id": "tech_signal_bell",
      "title": "Склянки глубины",
      "template": "roar",
      "weapon": "bell",
      "reference": "mammoth-stomp",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Адмирал поднимает колокол наружу.",
        "Четыре присосавшиеся руки удерживают мантию при обратном замахе.",
        "Раструб останавливается, внутри ударяет язык.",
        "От раструба расходятся звуковые кольца и жемчужины воздуха.",
        "Мантию и кисть отводит отдачей, язык успокаивается."
      ]
    },
    {
      "id": "tech_sounding",
      "title": "Огни промера",
      "template": "overhead",
      "weapon": "lantern",
      "reference": "guardian-strike",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Адмирал меряет глубину синим сигнальным фонарём.",
        "Поднимает фонарь высоко, опираясь на противоположные щупальца.",
        "Вес мантии движется за опускаемой лампой, донышко касается грунта.",
        "Бирюзовые отметки глубин прокатываются по дну ступенями.",
        "Из света выныривает фонарь, кисть сворачивается."
      ]
    },
    {
      "id": "tech_pennant",
      "title": "Шквал по сигналу",
      "template": "sweep",
      "weapon": "pennant",
      "reference": "mammoth-tusks",
      "parameters": {
        "strength": 1,
        "amplitude": 1,
        "side": 1,
        "repeats": 1
      },
      "logic": [
        "Рука с алым вымпелом даёт сигнал эскадре.",
        "Щупальца сцепляются с дном, древко поднимается сбоку.",
        "Резкий разворот мантии проносит конец флажка через воду.",
        "За бахромой расходятся ряды пенных гребней.",
        "Флаг складывается вдоль рукояти, опоры разжимаются."
      ]
    }
  ],
