{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet painting behavior",
  "type": "object",
  "required": [
    "seed",
    "previewSeconds",
    "field",
    "stride",
    "depthScale",
    "stops",
    "walkShare",
    "weights",
    "events",
    "yaw"
  ],
  "anyOf": [
    { "required": ["attackInterval"] },
    { "required": ["lifeAttacks"] },
    { "required": ["tricks"] }
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "previewSeconds": {
      "const": 30
    },
    "field": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "stride": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "depthScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stops": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "walkShare": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0.35,
        "maximum": 0.5
      }
    },
    "attackInterval": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 30,
        "maximum": 45
      }
    },
    "attacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tech_[a-z0-9_]+$"
      }
    },
    "lifeAttacks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^tech_[a-z0-9_]+$" }
    },
    "weights": {
      "type": "object",
      "required": [
        "idle",
        "fidget_a",
        "fidget_b",
        "look",
        "trick"
      ],
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "attackBounds": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^tech_[a-z0-9_]+$": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "events": {
      "type": "object",
      "required": [
        "tap",
        "tap_asleep",
        "like",
        "idle_owner",
        "owner_back",
        "skill_ready"
      ],
      "properties": {
        "tap": {
          "const": [
            "happy"
          ]
        },
        "tap_asleep": {
          "const": [
            "wake_startled",
            "happy"
          ]
        },
        "like": {
          "const": [
            "trick"
          ]
        },
        "double_tap": {
          "const": [
            "trick"
          ]
        },
        "rare_find": {
          "const": [
            "happy"
          ]
        },
        "approach": {
          "const": [
            "look"
          ]
        },
        "idle_owner": {
          "const": [
            "sleep_in",
            "sleep"
          ]
        },
        "owner_back": {
          "const": [
            "sleep_out"
          ]
        },
        "skill_ready": {
          "anyOf": [
            { "const": ["attack"] },
            { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "pattern": "^trick" } }
          ]
        }
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "yaw": {
      "type": "number"
    },
    "tricks": {
      "description": "TZ-B10: tricks of the first and the second form instead of attacks",
      "type": "object",
      "required": ["f1", "f2"],
      "additionalProperties": false,
      "properties": {
        "f1": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "f2": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
